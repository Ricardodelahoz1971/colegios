		}
--></script></div><!--end-box--></div><div id="respuestas" class="collapse"><!--pos=2--><!--begin-box:CNA_Home_form_respuestas:resultados:32924:Respuestas del formulario--><!--loc('* Tabla de cruce de valores para cuenta de artículos')--><div id="resultados" class="resultados"><table><thead><tr><th></th><th title="">Respuesta form - CNA </th></tr></thead><tbody><tr><th title="">Acreditación Institucional por lugar de desarrollo</th><td>54</td></tr><tr><th title="">Modificación en la temporalidad de la Acreditación</th><td>26</td></tr><tr><th title="">Nuevos factores y características de evaluación para Instituciones y Programas</th><td>123</td></tr><tr><th title="">Incluye seguimiento y evaluación como parte del proceso de Acreditación</th><td>59</td></tr><tr><th title="">Todas las anteriores</th><td>388</td></tr><tr><th title="">Desconozco los cambios que presenta la Actualización del Modelo de Acreditación</th><td>82</td></tr></tbody></table></div><!--end-box--><div id="graph"></div></div><div id="boton_otras" class="form_button btn-resultados pt-4 text-center"><form><input name="boton_otros" value="Otras encuestas" id="boton_otros" type="button" class="" onclick="goToURL(); return false;"></form></div></div><!--end-box--><!--begin-box:CNA_Home_tabsredes::32802:Articulo completo de este molde--><!--loc('* Código HTML libre dentro de la página.')--><div class="col-lg-4 py-5 redes-feed">
