					$(document).ready(function() {
    $( ".tabs" ).tabs();
    
    $('#myTab a.nav-link',$(this)).each(function(ida){
      var url = $(this).attr('href');
      $(this).attr('aria-controls',url.substring($(this).attr('href').indexOf('#')+1)).attr('role','tab').attr('data-toggle','tab');
      $(this).attr('href',url.substring($(this).attr('href').indexOf('#')));
    });
    
    $(".ntgBootstrap").each( function(){
		var myself = $(this);
		$.map(
			$.grep(myself.attr("class").split(" "),
				function(e,i){ 
					return(e.indexOf("data-") != -1 || e.indexOf("role_") != -1);
				}) ,
			function(classname,index){
				cl = classname.replace("\\","");
				myself.attr( cl.split("_")[0], cl.split("_")[1]);
				myself.removeClass("ntgBootstrap");
				myself.removeClass(classname);
			});
	});
  });
					--></script><!--end-box--><!--pos=4--><!--begin-box:CNA_tr_link_youtube::32755:Articulo completo de este molde--><!--loc('* Código JavaScript para la página.')--><script type="text/javascript" src="boxes-32755_js_file.js"></script><script type="text/javascript"><!--
