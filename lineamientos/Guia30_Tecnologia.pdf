					var inqaahe = [3, 5, 6, 8, 9, 10, 15, 12, 13, 24, 18, 25, 32, 27, 26, 29, 30, 35, 37, 71, 40, 45, 49, 52, 55, 54, 57, 63, 42, 61, 66, 69, 75, 74, 78, 76, 80, 81, 82, 84, 83, 86, 87, 90, 91, 88, 94, 99, 115, 56, 113, 105, 110, 116, 123, 121, 124, 122, 125, 126, 136, 127, 130, 135, 128, 54, 131, 138, 139, 178, 142, 155, 180, 51, 97, 156, 28, 161, 17, 165, 167, 170, 4, 59, 173, 176, 181, 182];
var siaces = [5, 29, 35, 48, 51, 38, 128, 134, 105, 172, 120, 127, 149, 70, 37];
var riaces = [21, 22, 29, 35, 37, 38, 48, 149, 51, 105, 120, 127, 135, 128, 46, 172];
var arcu = [5, 21, 22, 29, 35, 135, 172];

$(function () {
  
  $("a#main_link").prop("href","#contenido_principal");
    //   Cargar img por defecto en los valores de clasificando
    if ($(".recuadro-valores")) {
        $(".recuadro-valores .recuadro").each(function () {
            if ($(this).find(".figure").length < 1) {
                $(this).prepend('<a href="/portal/">aaaa</a><div class="col-lg-6 figure"><img src="/static/cache/binaries/channels-976_demo_recuadro.jpg"/></div>')
            }
        });
    }
    $("#formulario_i__CNA_Home_form_1 form").removeClass("col-lg-8");

    if ($("#i__CNA_ar_valores_consejo_1")) {
        $("#i__CNA_ar_valores_consejo_1 ul li a.pvid-67533").attr("href", "w3-propertyvalue-67530.html#consejeros");
        $("#i__CNA_ar_valores_consejo_1 ul li a.pvid-67534").attr("href", "w3-propertyvalue-67530.html#secretaria");
    }
    if ($("#i__CNA_ar_valores_hitos_1")) {
        $("#i__CNA_ar_valores_hitos_1 ul li a.pvid-67551").attr("href", "w3-propertyvalue-67531.html#historia");
        $("#i__CNA_ar_valores_hitos_1 ul li a.pvid-67547").attr("href", "w3-propertyvalue-67531.html#exconsejo");
    }

    if ($("#i__CNA_ar_valores_consejo_1").length > 0 && $("#i__CNA_ar_valores_hitos_1").length > 0) {
        $("#i__CNA_ar_valores_hitos_1").hide();
        $(".migapan").empty();
        $(".migapan").append('<p id="i__CNA_pa_breadcrumb_1_67530" class="migapan" style=""><a class="channellink" href="/portal/">Inicio</a><a href="/portal/El-CNA/" class=" pnid-3581 pv-pid-0 pvid-67522 cid-976">El CNA</a><a class="current pvid-67530 cid-976 active" href="/portal/El-CNA/Estructura/">Estructura</a></p>');

    }


    var url = window.location.href;
    if (url.indexOf("#conseje") > -1 || url.indexOf("#historia") > -1) {
        $("#dia1-tab").trigger("click");
    }
    if (url.indexOf("#secretar") > -1 || url.indexOf("#exconsejo") > -1) {
        $("#dia2-tab").trigger("click");
    }

    //clase link_hover para enviar el link del epigrafe al hover del recuadro
    $('.link_hover .recuadro').each(function () {
        var url = $(this).find('.titulo a').attr('href');

        $(this).find('.abstract').wrapInner('<a href=' + url + ' target="blank"></a>');
        $(this).find('.titulo a').contents().unwrap();
    });

    $(".link_modal .recuadro").each(function () {
        $(this).find(".titulo a").prop("href", $(this).find(".documento a").prop("href"));

        $(this).find("a").attr("data-toggle", "modal");
        $(this).find("a").attr("data-target", "myModal");
    });

    $(".articulo.link_modal, .link_modal_doc .recuadro").each(function () {
        $(this).find("a").attr("data-toggle", "modal");
        $(this).find("a").attr("data-target", "myModal");
    });

    $('#myModal').on('hidden.bs.modal', function (e) {
        $('#myModal').find('.modal-body').empty();
    });

    $(".link_modal .recuadro a, .articulo.link_modal a, .link_modal_doc a").click(function () {
        abrirModalBoletin($(this).prop("href"));

    });

    // Mostrar / Ocultar respuestas de formulario 

    $("#encuesta form .btn-resultados input[type=button]").attr("data-toggle", "collapse");
    $("#encuesta form .btn-resultados input[type=button]").attr("data-target", "#respuestas");

    // Obtener miniaturas Youtube para las capsulas informativas
    if ($("#capsulas").length > 0) {
        $("#capsulas .recuadro .epigrafe").each(function () {
            var yt_id = YouTubeGetID($(this).text());
            var yt_html = "<div class='img-fluid-cc'><img src='https://img.youtube.com/vi/" + yt_id + "/0.jpg'</div>";
            $(this).replaceWith(yt_html);
        });
    }

    // Span para personalizar chekbox formularios

    $(".form_select li").append("<span></span>");

    $("a.link-mapa").click(function () {

        $("#mapa svg g path").removeClass("orange");
        $("a.link-mapa").parent().removeClass("active");
        $(this).parent().addClass("active");

        var id = $(this).prop("id");
        var array_ids = [];
        switch (id) {
            case "inqaahe":
                array_ids = inqaahe;
                break;
            case "siaces":
                array_ids = siaces;
                break;
            case "riaces":
                array_ids = riaces;
                break;
            case "arcu":
                array_ids = arcu;
                break;
        }
        for (var j = 0; j < array_ids.length; j++) {
            $("#mapa svg g path:nth-child(" + array_ids[j] + ")").addClass("orange");
        }

        if ($(window).width() < 990) {
            $('body,html').animate({
                scrollTop: $('#mapa').offset().top - 100
            }, 800);

        }
    });

});

function abrirModalBoletin(ruta) {
    var h_ref = ruta;
    //   var iframe = "<embed src='"+h_ref+"#toolbar=0&navpanes=0&scrollbar=0' width='500' height='500'>";
    var iframe = "<div class='embed-responsive embed-responsive-16by9'>" +
        "              <iframe class='embed-responsive-item' src='" + h_ref + "'>" +
        "              </iframe>" +
        "            </div>'";

    $('#myModal').find('.modal-body').append(iframe);
    $("a.link_youtube").ntg_link_video();
    $('#myModal').modal('show');
}

function YouTubeGetID(url) {
    var ID = '';
    url = url.replace(/(>|<)/gi, '').split(/(vi\/|v=|\/v\/|youtu\.be\/|\/embed\/)/);
    if (url[2] !== undefined) {
        ID = url[2].split(/[^0-9a-z_\-]/i);
        ID = ID[0];
    } else {
        ID = url;
    }
    return ID;
}
