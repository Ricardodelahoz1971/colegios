	function CNA_formulario_DEMO32804Submit(frm, type) {

		if( CNA_formulario_DEMO32804IsValid(frm) ) {
			if ( type != 'submit' ){
				var link = decodeURI("https://cms.mineducacion.gov.co/mod/form/cgi/form.cgi");
				var v;
				if( type == 'savetourifragment_submit' ) {
					var rnd = String(Math.random()).substr(0,6);
					if( link.indexOf('?') == -1 ) {
						link += '?' + rnd;
					} else {
						link = link.replace('?', '?' + rnd + '&');
					}
					link += '#';
				}
			
				v = getValue(frm.campo2);
				if( v.length ) {
					if( type == 'savetocookies_submit' ) {
						setCookie('CNA_formulario_DEMO_campo2', v);
					} else if(type == 'savetocookiesnoname_submit') {
						setCookie('campo2', v);
					} else if( type == 'savetourifragment_submit' ) {
						link += '&campo2=' + encodeURIComponent(v);
					}
				} else {
					if( type == 'savetocookies_submit' ) {
						deleteCookie('CNA_formulario_DEMO_campo2');
					}
					else if(type == 'savetocookiesnoname_submit') {
						deleteCookie('campo2');
					}
				}
			
				var reload = 0;
				window.location.href=link;
			}
			else {
				frm.submit();
			}
		}
		return false;
	}
	
	function CNA_formulario_DEMO32804IsValid_(frm) {
		_is_valid = true;
		_field = frm.campo1;if((_field&&_field.validity&&!_field.checkValidity())){$(_field).focus();$('#campo1_div_775').addClass('ntg-invalid');$('#campo1_div_775 span.ntg-warning').remove();$('#campo1_div_775 label:first').after('<span class="ntg-warning alert alert-warning"><\/span>');$('#campo1_div_775 span.ntg-warning').text('Debe especificar Pregunta');_is_valid = false;}else{$('#campo1_div_775 span.ntg-warning').remove();$('#campo1_div_775').removeClass('ntg-invalid');}
			_field = frm.campo2;if((_field&&_field.validity&&!_field.checkValidity())||!((getValue(frm.campo2) != ''))){$(_field).focus();$('#campo2_div_775').addClass('ntg-invalid');$('#campo2_div_775 span.ntg-warning').remove();$('#campo2_div_775 label:first').after('<span class="ntg-warning alert alert-warning"><\/span>');$('#campo2_div_775 span.ntg-warning').text('Debe seleccionar una opción');_is_valid = false;}else{$('#campo2_div_775 span.ntg-warning').remove();$('#campo2_div_775').removeClass('ntg-invalid');}
			_field = frm.boton1;if((_field&&_field.validity&&!_field.checkValidity())){$(_field).focus();$('#boton1_div_775').addClass('ntg-invalid');$('#boton1_div_775 span.ntg-warning').remove();$('#boton1_div_775 label:first').after('<span class="ntg-warning alert alert-warning"><\/span>');$('#boton1_div_775 span.ntg-warning').text('Debe especificar Enviar');_is_valid = false;}else{$('#boton1_div_775 span.ntg-warning').remove();$('#boton1_div_775').removeClass('ntg-invalid');}
			_field = frm.boton2;if((_field&&_field.validity&&!_field.checkValidity())){$(_field).focus();$('#boton2_div_775').addClass('ntg-invalid');$('#boton2_div_775 span.ntg-warning').remove();$('#boton2_div_775 label:first').after('<span class="ntg-warning alert alert-warning"><\/span>');$('#boton2_div_775 span.ntg-warning').text('Debe especificar Ver resultados');_is_valid = false;}else{$('#boton2_div_775 span.ntg-warning').remove();$('#boton2_div_775').removeClass('ntg-invalid');}
			return _is_valid;
		}
	
	function CNA_formulario_DEMO32804IsValid(frm) {
		__is_valid = new Array(true);
__is_valid.push(CNA_formulario_DEMO32804IsValid_(frm));
return __is_valid.reduce(function(a, b) { return a && b; });
	}
	function CNA_formulario_DEMOEvent(frm) {
	
		return;
	}
	--></script><fieldset class="forminvisible"><legend class="ntg-titulo-formulario"></legend><input type="hidden" name="HTTP_REFERER" value="" id="HTTP_REFERER_775"><input type="hidden" name="HTTP_REFERER_PREV" value="" id="HTTP_REFERER_PREV_775"><input type="hidden" name="action" value="exeResponse" id="action_775"><input type="hidden" name="fdid" value="775" id="fdid_775"><input type="hidden" name="cid" value="965" id="cid_775"><input type="hidden" name="context_cid" value="976" id="context_cid_775"><input type="hidden" name="context_iid" value="1779" id="context_iid_775"></fieldset><fieldset><legend class="ntg-titulo-formulario"></legend><div id="campo1_div_775" class="form_message"><span>Pregunta<br>  <small class="ntg-formulario-texto-abajo">¿Cuáles considera son los principales cambios que presenta la Actualización del Modelo de Acreditación (Acuerdo CESU 02 del 01 de julio de 2020)?</small></span></div><div id="campo2_div_775" class="form_select ntg-required"><label><span style="white-space: nowrap">Opciones</span></label><div><ul><li><input type="radio" name="campo2" value="67726" id="campo2_775_1_1" onclick="javascript:CNA_formulario_DEMOEvent(this.form);">- Acreditación Institucional por lugar de desarrollo </li></ul></div><div><ul><li><input type="radio" name="campo2" value="67727" id="campo2_775_2_1" onclick="javascript:CNA_formulario_DEMOEvent(this.form);">- Modificación en la temporalidad de la Acreditación </li></ul></div><div><ul><li><input type="radio" name="campo2" value="67728" id="campo2_775_3_1" onclick="javascript:CNA_formulario_DEMOEvent(this.form);">- Nuevos factores y características de evaluación para Instituciones y Programas </li></ul></div><div><ul><li><input type="radio" name="campo2" value="67729" id="campo2_775_4_1" onclick="javascript:CNA_formulario_DEMOEvent(this.form);">- Incluye seguimiento y evaluación como parte del proceso de Acreditación </li></ul></div><div><ul><li><input type="radio" name="campo2" value="67730" id="campo2_775_5_1" onclick="javascript:CNA_formulario_DEMOEvent(this.form);">- Todas las anteriores </li></ul></div><div><ul><li><input type="radio" name="campo2" value="67731" id="campo2_775_6_1" onclick="javascript:CNA_formulario_DEMOEvent(this.form);">- Desconozco los cambios que presenta la Actualización del Modelo de Acreditación </li></ul></div></div><div id="boton1_div_775" class="form_button"><input name="boton1" value="Responder" id="boton1_775" type="button" onclick="javascript:return CNA_formulario_DEMO32804Submit(this.form, 'submit')"></div><div id="boton2_div_775" class="form_button btn-resultados"><input name="boton2" value="Ver resultados" id="boton2_775" type="button"></div></fieldset></form><script type="text/javascript"><!--
		var _frm = document.getElementById('CNA_formulario_DEMO');
