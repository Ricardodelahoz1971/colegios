</script><!--end-box--><!--begin-box:CNA_home_lib_grafica::32974:LIbrerias javascript para el funcionamiento de las gráficas de comunidades--><!--loc('* Código HTML libre dentro de la página.')--><!-- Load d3.js and c3.js -->
<script src="channels-976_graph_d3_js.js"></script>
<script src="channels-976_graph_c3_js.js"></script><!--end-box--><!--begin-box:CNA_home_js_grafica::32973:JS con la configuración especial del historico de formularios--><!--loc('* Código JavaScript para la página.')--><script type="text/javascript"><!--
					$(function () {
  
  $("#resultados table").hide();
  
    var titulo = $("#resultados table thead th[title]").text();
    datos = [];
    textos = [];
    count = 0;

    $("#resultados table tbody tr").each(function () {
        count = parseInt($(this).find("td").text());
        datos.push(count);
        textos.push($(this).find("th").text());
    });

    datos.unshift('Respuestas');

    if ($("#graph").hasClass('c3')) {
        chart = chart.destroy();
    }

    chart = c3.generate({
        bindto: '#graph',
        data: {
            columns: [datos],
            type: 'bar',
            labels: true,
            color: function (inColor, data) {
                var ide_x = data.x;
                var color_x;
                switch (ide_x) {
                    case 0:
                        color_x = "#242951"
                        break;
                    case 1:
                        color_x = "#F6A337"
                        break;
                    case 2:
                        color_x = "#0082A0"
                        break;

                    case 3:
                        color_x = "#069169"
                        break;
                    case 4:
                        color_x = "#6f42c1"
                        break;
                    case 5:
                        color_x = "#F3561F"
                        break;
                }

                return color_x;
            }
        },
        axis: {
            x: {
                type: 'category',
                categories: textos
            }
        },
        legend: {
            show: false
        }
    });
});

function goToURL(){
  location.href = 'w3-propertyvalue-67544.html';
}
					--></script><!--end-box--></body></html>