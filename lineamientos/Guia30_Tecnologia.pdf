  $('.link_iframe a, a.link_iframe').each(function(){
    var url =$(this).attr('href');
    var html ='<div class="iframe-embebido embed-responsive embed-responsive-16by9">'+
        '<iframe class="embed-responsive-item" src="'+url+'"></iframe>'+
        '</div>';
    //$(this).parent('div').append(html);
    //$(this).hide();
    $(this).replaceWith(html);
    
  });
});
					--></script><!--end-box--><!--pos=6--><!--begin-box:CNA_js_MenuFijo::32758:Caja que contiene js para menú fijo--><!--loc('* Código JavaScript para la página.')--><script type="text/javascript" src="boxes-32758_js_file.js"></script><!--end-box--><!--pos=7--><!--begin-box:Elementos_tr_accesibilidad::34984:js para accesibilidad--><!--loc('* Código HTML libre dentro de la página.')-->    <div id="accesibilidad-menu" class="accesibilidad-menu">
        <ul class="accesibilidad-items">
