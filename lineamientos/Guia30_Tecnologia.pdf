   $('.link_youtube a, a.link_youtube').ntg_link_video();
});
					--></script><!--end-box--><!--pos=5--><!--begin-box:CNA_js_link_iframe::32756:Script para convertir links en iframe--><!--loc('* Código JavaScript para la página.')--><script type="text/javascript"><!--
